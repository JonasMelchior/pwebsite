# HTTP Server Configuration (Runs on port 8081 by default)
quarkus.http.port=${PORT:8081}
quarkus.http.test-port=0
quarkus.http.host=0.0.0.0

# Prview Strava Widget URL
widget.url=${WIDGET_URL:http://localhost:8080}

# Logging Configuration
quarkus.log.category."org.jonas".level=INFO
quarkus.log.console.format=%d{HH:mm:ss} [%p] %m%n
